[Unit]
Description=Advertisement Video Player Auto-Start
Documentation=https://github.com/yourproject/adver-player
After=graphical.target
Wants=graphical.target

[Service]
Type=forking
User=root
Group=root

# Wait a bit for desktop environment to fully initialize
ExecStartPre=/bin/sleep 5

# Start the video player using video.sh
ExecStart=/home/pi/viewer/video.sh

# Restart policy
Restart=on-failure
RestartSec=10

# Environment variables for GUI access
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/pi/.Xauthority"

# Resource limits
Nice=-10
CPUQuota=80%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=adver-player

[Install]
WantedBy=graphical.target
